# Copie ce fichier en .env.local (jamais commit, voir .gitignore) et remplis ta vraie clé.
ANTHROPIC_API_KEY=

# Optionnel : si défini, protège l'app derrière un portail à code d'accès.
# Liste séparée par virgules — un code unique par acheteuse (paiement unique) :
# généré à la main, ajouté ici après paiement, retiré (puis redéployer) pour
# couper l'accès d'une seule personne sans affecter les autres.
# Laisser vide en dev = pas de portail.
ACCESS_CODES=
